@page "/home"

@using System.Data
@using Microsoft.Data.SqlClient
@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using RBI_Malaysia.Components.Shared
@using Microsoft.JSInterop
@implements IDisposable
@inject DashboardService DashboardService
@inject UserSession UserSession
@inject IJSRuntime JS

<SessionGuard />

<PageTitle>RBI Malaysia - Dashboard</PageTitle>

<div class="dashboard-page">

    <!-- Header -->
    <div class="dashboard-header">

        <div>
            <h3>Risk Based Inspection Dashboard</h3>
            <p>API 581 Quantitative Monitoring System</p>
        </div>

        <button class="btn btn-primary add-equipment-btn">
            <i class="bi bi-plus-circle me-2"></i>
            Add Equipment
        </button>

    </div>


    <!-- KPI CARDS -->
    <div class="row g-4 mb-4">

        <!-- Total Equipment -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-card kpi-card">

                <div>
                    <div class="kpi-title">
                        Total Equipment
                    </div>

                    <div class="kpi-value">
                        @if (loading || dashboard == null)
                        {
                            <span>...</span>
                        }
                        else
                        {
                            @dashboard.TotalEquipment.ToString("N0")
                        }
                    </div>
                </div>

                <div class="kpi-icon primary">
                    <i class="bi bi-hdd-stack"></i>
                </div>

            </div>

        </div>


        <!-- High Risk -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-card kpi-card">

                <div>
                    <div class="kpi-title">
                        High Risk Assets
                    </div>

                    <div class="kpi-value danger">
                        @(dashboard2?.HighRisk ?? 0)
                    </div>
                </div>

                <div class="kpi-icon danger-bg">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>

            </div>

        </div>


        <!-- Medium Risk -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-card kpi-card">

                <div>
                    <div class="kpi-title">
                        Medium Risk
                    </div>

                    <div class="kpi-value warning">
                        @(dashboard2?.MediumRisk ?? 0)
                    </div>
                </div>

                <div class="kpi-icon warning-bg">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

            </div>

        </div>


        <!-- Low Risk -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-card kpi-card">

                <div>
                    <div class="kpi-title">
                        Low Risk
                    </div>

                    <div class="kpi-value success">
                        @(dashboard2?.LowRisk ?? 0)
                    </div>
                </div>

                <div class="kpi-icon success-bg">
                    <i class="bi bi-check-circle"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- CHARTS -->
    <div class="row g-4 mb-4">

        <!-- Risk Distribution -->
        <div class="col-12 col-lg-8">

            <div class="dashboard-card chart-card">

                <h5>Risk Distribution</h5>

                <div class="risk-chart">

                    <div class="chart-row">

                        <div class="chart-label">
                            <span>High</span>
                            <strong>  @(dashboard2?.HighRisk ?? 0)</strong>
                        </div>

                        <div class="chart-bar-container">
                            <div class="chart-bar high-bar"
                                 style="width: 4%;">
                            </div>
                        </div>

                    </div>


                    <div class="chart-row">

                        <div class="chart-label">
                            <span>Medium</span>
                            <strong>  @(dashboard2?.MediumRisk ?? 0)</strong>
                        </div>

                        <div class="chart-bar-container">
                            <div class="chart-bar medium-bar"
                                 style="width: 4%;">
                            </div>
                        </div>

                    </div>


                    <div class="chart-row">

                        <div class="chart-label">
                            <span>Low</span>
                            <strong>  @(dashboard2?.LowRisk ?? 0)</strong>
                        </div>

                        <div class="chart-bar-container">
                            <div class="chart-bar low-bar"
                                 style="width: 100%;">
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Inspection Status -->
        <div class="col-12 col-lg-4">

            <div class="dashboard-card chart-card">

                <h5>Inspection Status</h5>

                <div class="inspection-chart">

                    <div class="donut">

                        <div class="donut-center">
                            <strong>72%</strong>
                            <span>Completed</span>
                        </div>

                    </div>

                </div>


                <div class="inspection-legend">

                    <div>
                        <span class="legend-dot completed"></span>
                        Completed
                        <strong>72%</strong>
                    </div>

                    <div>
                        <span class="legend-dot pending"></span>
                        Pending
                        <strong>18%</strong>
                    </div>

                    <div>
                        <span class="legend-dot overdue"></span>
                        Overdue
                        <strong>10%</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- RISK MATRIX -->
    <div class="dashboard-card p-4 mb-4">

        <h5 class="section-title">
            API 581 Risk Matrix
        </h5>

        <div class="row g-3">

            <div class="col-12 col-md-4">

                <div class="risk-box low-risk">

                    <i class="bi bi-check-circle"></i>

                    <span>Low Risk</span>

                </div>

            </div>


            <div class="col-12 col-md-4">

                <div class="risk-box medium-risk">

                    <i class="bi bi-exclamation-triangle"></i>

                    <span>Medium Risk</span>

                </div>

            </div>


            <div class="col-12 col-md-4">

                <div class="risk-box high-risk">

                    <i class="bi bi-exclamation-octagon"></i>

                    <span>High Risk</span>

                </div>

            </div>

        </div>

    </div>


    <!-- CRITICAL EQUIPMENT -->
    <div class="dashboard-card equipment-card">

        <div class="equipment-header">

            <h5>
                Critical Equipment
            </h5>

            <button class="btn btn-outline-primary btn-sm">
                View All
            </button>

        </div>


        <div class="table-responsive">

            <table class="table equipment-table align-middle">

                <thead>

                    <tr>
                        <th>Tag No</th>
                        <th>Equipment</th>
                        <th>Risk</th>
                        <th>Remaining Life</th>
                        <th>Inspection</th>
                        <th>Status</th>
                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td data-label="Tag No">
                            <strong>V-101</strong>
                        </td>

                        <td data-label="Equipment">
                            Separator Vessel
                        </td>

                        <td data-label="Risk">
                            <span class="badge bg-danger">
                                High
                            </span>
                        </td>

                        <td data-label="Remaining Life">
                            1.8 Years
                        </td>

                        <td data-label="Inspection">
                            12-Jun-2026
                        </td>

                        <td data-label="Status">
                            <span class="badge bg-warning text-dark">
                                Action Required
                            </span>
                        </td>

                    </tr>


                    <tr>

                        <td data-label="Tag No">
                            <strong>P-220</strong>
                        </td>

                        <td data-label="Equipment">
                            Process Piping
                        </td>

                        <td data-label="Risk">
                            <span class="badge bg-warning text-dark">
                                Medium
                            </span>
                        </td>

                        <td data-label="Remaining Life">
                            4.2 Years
                        </td>

                        <td data-label="Inspection">
                            28-Jul-2026
                        </td>

                        <td data-label="Status">
                            <span class="badge bg-info">
                                Monitoring
                            </span>
                        </td>

                    </tr>


                    <tr>

                        <td data-label="Tag No">
                            <strong>E-330</strong>
                        </td>

                        <td data-label="Equipment">
                            Heat Exchanger
                        </td>

                        <td data-label="Risk">
                            <span class="badge bg-success">
                                Low
                            </span>
                        </td>

                        <td data-label="Remaining Life">
                            9.5 Years
                        </td>

                        <td data-label="Inspection">
                            15-Oct-2026
                        </td>

                        <td data-label="Status">
                            <span class="badge bg-success">
                                Healthy
                            </span>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

@code
{

  
    private bool loading = false;
    private DashboardModel? dashboard,dashboard2; // உங்கள் கிளாஸ் பெயர் எதுவோ அதை மாற்றிக்கொள்ளவும்

    protected override async Task OnInitializedAsync()
    {
        // 1. UserSession இல் ஏதேனும் மாற்றம் நடந்தால் LoadDashboard இயங்க வேண்டும் என்று லிங்க் செய்கிறோம்
        UserSession.OnChange += OnSessionChanged;

        // 2. ஒருவேளை ஏற்கனவே CompanyID லோடு ஆகியிருந்தால், உடனே டேட்டாவை எடுக்கிறோம்
        if (!string.IsNullOrWhiteSpace(UserSession.CompanyID))
        {
            await LoadDashboard();
        }
    }

    // செஷனில் கம்பெனி ஐடி செட் ஆன உடனே இந்த மெத்தட் தானாக இயங்கும்
    private async void OnSessionChanged()
    {
        await InvokeAsync(async () =>
        {
            if (!string.IsNullOrWhiteSpace(UserSession.CompanyID) && dashboard == null)
            {
                await LoadDashboard();
                StateHasChanged(); // பக்கத்தை ரீ-ரெண்டர் செய்ய கட்டாயப்படுத்துகிறது
            }
        });
    }

    private async Task LoadDashboard()
    {
        // ஏற்கனவே டேட்டா லோடு ஆகியிருந்தாலோ அல்லது லோடிங் நடந்து கொண்டிருந்தாலோ திரும்ப இயக்க வேண்டாம்
        if (loading || dashboard != null) return;

        try
        {
            loading = true;

            if (string.IsNullOrWhiteSpace(UserSession.CompanyID))
            {
                return;
            }

            if (!decimal.TryParse(UserSession.CompanyID, out decimal companyId))
            {
                return;
            }

            dashboard = await DashboardService.GetDashboardSummaryAsync(companyId);
            dashboard2 = await DashboardService.GetDashboardSummaryAsync2(companyId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Dashboard loading failed: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    // பக்கம் அழியும்போது (Dispose) மெமரி லீக் (Memory Leak) ஏற்படாமல் இருக்க ஈவென்ட்டை நீக்குகிறோம்
    public void Dispose()
    {
        UserSession.OnChange -= OnSessionChanged;
    }
}

    