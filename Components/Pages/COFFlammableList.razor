@page "/cof-flammable-list"

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using Microsoft.JSInterop
@inject COFFlammableService COFService
@inject UserSession UserSession
@inject IConfiguration Configuration
@inject IJSRuntime JS
@* @inject NavigationManager Navigation
 *@
<PageTitle>COF — Flammable Records List</PageTitle>

<div class="staff-page">
    <div class="staff-card">

        <div class="staff-card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-fire me-2 text-danger"></i> COF Flammable — Records
                </h5>
                <small>Filter and manage COF Flammable Consequence records</small>
            </div>
            <div class="staff-buttons">
                <NavLink class="btn btn-primary add-equipment-btn" href="cof-flammable">
                    <i class="bi bi-plus-circle me-2"></i>
                    Add COFFlammable
                </NavLink>
            </div>
        </div>

        <div class="staff-card-body">

            <!-- Cascading Filters -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Process Area</label>
                    <select class="form-select" value="@selectedProcessArea" @onchange="ProcessAreaChanged">
                        <option value="0">-- All Process Areas --</option>
                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">@item.ProcessArea</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Equipment</label>
                    <select class="form-select" value="@selectedEquipment" @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">
                        <option value="0">-- All Equipments --</option>
                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">@item.EquPID</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Component</label>
                    <select class="form-select" value="@selectedComponent" @onchange="ComponentChanged"
                            disabled="@(selectedEquipment <= 0)">
                        <option value="0">-- All Components --</option>
                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">@item.CompNo</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div @key="renderKey">
                @if (isLoading)
                {
                    <p class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Loading...</p>
                }
                else if (rows.Count == 0)
                {
                    <p class="text-muted">No COF Flammable records found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="cofFlammableListTable" class="table table-hover staff-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>View</th>
                                    <th>Process Area</th>
                                    <th>Equipment</th>
                                    <th>Component</th>
                                    <th>Fluid Stored</th>
                                    <th>Rep Fluid</th>
                                    <th>Op Pressure</th>
                                    <th>Op Temp</th>
                                    <th>Detection</th>
                                    <th>Isolation</th>
                                    <th>CA Damage</th>
                                    <th>Damage Cat</th>
                                    <th>CA Injury</th>
                                    <th>Injury Cat</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int i = 1; }
                                @foreach (var row in rows)
                                {
                                    var r = row;
                                    <tr>
                                        <td>
                                            <button class="btn btn-sm btn-success" title="Report" style="width:40px"
                                                    @onclick="() => ReportView(r)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                        <td>@r.ProcessArea</td>
                                        <td>@r.EquipmentName</td>
                                        <td>@r.ComponentName</td>
                                        <td>@r.Fluid</td>
                                        <td>@r.Repfluid</td>
                                        <td>@r.OpPres</td>
                                        <td>@r.OpTemp</td>
                                        <td>@r.Detect</td>
                                        <td>@r.Iso</td>
                                        <td class="fw-bold">@r.CAcmdTotal</td>
                                        <td>
                                            <span class="badge @GetCatBadge(r.CAcmdCategory)">@r.CAcmdCategory</span>
                                        </td>
                                        <td class="fw-bold">@r.CAInjTotal</td>
                                        <td>
                                            <span class="badge @GetCatBadge(r.CAInjCategory)">@r.CAInjCategory</span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" title="Delete" style="width:40px"
                                                    @onclick="() => DeleteRow(r)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@code
{
    private decimal selectedProcessArea, selectedEquipment, selectedComponent;
    private bool isLoading;
    private int renderKey;
    private bool needsTableInit;

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel>   equipments   = new();
    private List<ComponentModel>   components   = new();

    private record Row(
        decimal ProcID, decimal EquID, decimal CompID,
        string ProcessArea, string EquipmentName, string ComponentName,
        string? Fluid, string? Repfluid, string? OpPres, string? OpTemp,
        string? Detect, string? Iso,
        string? CAcmdTotal, string? CAcmdCategory,
        string? CAInjTotal, string? CAInjCategory);

    private List<Row> rows = new();

    protected override async Task OnInitializedAsync()
    {
        processAreas = await COFService.GetFlamProcessAreasAsync(UserSession.CompanyID);
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsTableInit)
        {
            needsTableInit = false;
            try { await JS.InvokeVoidAsync("equipmentDataTable.initialize", "#cofFlammableListTable"); }
            catch { }
        }
    }

    private async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedEquipment = 0; selectedComponent = 0;
        equipments.Clear(); components.Clear();

        if (selectedProcessArea > 0)
            equipments = await COFService.GetflamEquipmentsByProcessAsync(selectedProcessArea);

        await LoadData();
    }

    private async Task EquipmentChanged(ChangeEventArgs e)
    {
        selectedEquipment = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedComponent = 0;
        components.Clear();

        if (selectedEquipment > 0)
            components = await COFService.GetFlamComponentsByEquipmentAsync(selectedEquipment.ToString());

        await LoadData();
    }

    private async Task ComponentChanged(ChangeEventArgs e)
    {
        selectedComponent = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            rows.Clear();
            string sql = @"
                SELECT f.ProcID, f.EquID, f.CompID,
                       pa.processarea,
                       ea.EqupID + ' - ' + ea.EqupType AS EquipName,
                       cd.CompNo  + ' - ' + cd.compname  AS CompName,
                       f.Fluid, f.Repfluid, f.OpPres, f.Optemp,
                       f.Detect, f.Iso,
                       f.CAcmdTotal, f.CAcmdCate,
                       f.CAInjTotal, f.CAinjCate
                FROM COF_Flammable f
                LEFT JOIN Tbl_ProcessArea               pa ON pa.ProcessAreaID = f.ProcID
                LEFT JOIN Tbl_EquipmentAsset            ea ON ea.EquAutoID     = f.EquID
                LEFT JOIN Tbl_EquipmentComponentDetails cd ON cd.compautoid    = f.CompID
                WHERE f.Deleted = 0 and pa.CompanyID=@companyID
                  AND (@ProcID = 0 OR f.ProcID = @ProcID)
                  AND (@EquID  = 0 OR f.EquID  = @EquID)
                  AND (@CompID = 0 OR f.CompID = @CompID)
                ORDER BY pa.processarea, ea.EqupID, cd.CompNo";

            using var conn = new Microsoft.Data.SqlClient.SqlConnection(GetConn());
            using var cmd  = new Microsoft.Data.SqlClient.SqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@ProcID", selectedProcessArea);
            cmd.Parameters.AddWithValue("@EquID",  selectedEquipment);
            cmd.Parameters.AddWithValue("@CompID", selectedComponent);
            cmd.Parameters.AddWithValue("@companyID", UserSession.CompanyID);
            await conn.OpenAsync();
            using var rd = await cmd.ExecuteReaderAsync();
            while (await rd.ReadAsync())
            {
                string? S(string c) => rd[c] == DBNull.Value ? null : rd[c].ToString();

                rows.Add(new Row(
                    Convert.ToDecimal(rd["ProcID"]),
                    Convert.ToDecimal(rd["EquID"]),
                    Convert.ToDecimal(rd["CompID"]),
                    S("processarea") ?? "", S("EquipName") ?? "", S("CompName") ?? "",
                    S("Fluid"), S("Repfluid"), S("OpPres"), S("Optemp"),
                    S("Detect"), S("Iso"),
                    S("CAcmdTotal"), S("CAcmdCate"),
                    S("CAInjTotal"), S("CAinjCate")));
            }

            renderKey++;
            needsTableInit = rows.Count > 0;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Error!", text = ex.Message, icon = "error" });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteRow(Row row)
    {
        // bool confirm = await JS.InvokeAsync<bool>("Swal.fire", new
        // {
        //     title             = "Delete Record?",
        //     text              = $"COF Flammable record for {row.ComponentName} will be permanently deleted.",
        //     icon              = "warning",
        //     showCancelButton  = true,
        //     confirmButtonColor = "#d33",
        //     cancelButtonColor  = "#6c757d",
        //     confirmButtonText  = "Yes, delete it!",
        //     cancelButtonText   = "Cancel"
        // }).ContinueWith(t => t.Result.GetProperty("isConfirmed").GetBoolean());

        bool confirmed =
           await JS.InvokeAsync<bool>("sweetAlert.confirmDelete", "Are you sure?", $"Do you want to delete this COF Flammable record for {row.ComponentName}?");

        if (!confirmed) return;

        try
        {
            string sql = "DELETE FROM COF_Flammable WHERE ProcID=@p AND EquID=@e AND CompID=@c";
            using var conn = new Microsoft.Data.SqlClient.SqlConnection(GetConn());
            using var cmd  = new Microsoft.Data.SqlClient.SqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@p", row.ProcID);
            cmd.Parameters.AddWithValue("@e", row.EquID);
            cmd.Parameters.AddWithValue("@c", row.CompID);
            await conn.OpenAsync();
            await cmd.ExecuteNonQueryAsync();

            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Deleted!", text = "Record has been deleted.", icon = "success",
                      timer = 1800, showConfirmButton = false });
            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Error!", text = ex.Message, icon = "error" });
        }
    }

    private async Task ReportView(Row row)
    {
        string url = $"/cof-flame-report/{row.CompID}"; 
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private static string GetCatBadge(string? cat) => cat switch
    {
        "A" => "bg-success",
        "B" => "bg-primary",
        "C" => "bg-warning text-dark",
        "D" => "bg-orange text-dark",
        "E" => "bg-danger",
        _   => "bg-secondary"
    };

    private string GetConn() =>
        Configuration.GetConnectionString("connString")
        ?? throw new InvalidOperationException("connString not found");
}
