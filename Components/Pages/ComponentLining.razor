                </div>


                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <div class="staff-buttons mt-4">

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="CalculateLining"
                            disabled="@loading">

