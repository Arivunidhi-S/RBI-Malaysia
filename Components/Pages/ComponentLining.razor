            </div>

        </div>
    @* } *@

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private LiningDamageModel model = new();

    private List<ProcessAreaModel> processAreas = new();

    private List<EquipmentModel> equipments = new();

    private List<ComponentModel> components = new();


    // =========================================================
    // SELECTED
    // =========================================================

    private decimal selectedProcessArea = 0;

    private string? selectedEquipment;

    private string? selectedComponent;

    private decimal selectedComponentId = 0;


    // =========================================================
    // LINING OPTIONS
    // =========================================================

    private List<int> liningAges = new();

    private List<LiningOption> dfbOptions = new();

    private string lineAgeLabel = "Years";


    // =========================================================
    // CALCULATION
    // =========================================================

    private decimal baseDfb = 0;

    private bool calculated = false;

    private bool existingRecord = false;

    private bool loading = false;


    // =========================================================
    // DESCRIPTION
    // =========================================================

    private string liningConditionDescription = "";

    private bool isDropdownOpen = false;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void SelectYear(int age)
    {
        model.SIyear = age;
        isDropdownOpen = false; // Closes dropdown safely

        // Manually trigger your original AgeChanged logic
        AgeChanged(new ChangeEventArgs { Value = age });
    }

    private void AgeChanged(ChangeEventArgs e)
    {
        // Your existing AgeChanged logic remains unchanged
    }


    // =========================================================
    // INITIALIZE
    // =========================================================




    protected override async Task OnInitializedAsync()
    {
        try
        {
            decimal companyId =
                Convert.ToDecimal(
                    UserSession.CompanyID);

            processAreas =
                await LiningService
                    .GetProcessAreasAsync(companyId);
        }
        catch (Exception ex)
        {
            await ShowError(
                "Component Lining loading failed.",
                ex.Message);
        }
    }


    // =========================================================
    // PROCESS AREA
    // =========================================================

    private async Task ProcessAreaChanged(
        ChangeEventArgs e)
    {
        selectedProcessArea = 0;

        decimal.TryParse(
            e.Value?.ToString(),
            out selectedProcessArea);

        selectedEquipment = null;
        selectedComponent = null;
        selectedComponentId = 0;

        equipments.Clear();
        components.Clear();

        ClearCalculation();

        if (selectedProcessArea <= 0)
            return;

        try
        {
            equipments =
                await LiningService
                    .GetEquipmentsAsync(
                        selectedProcessArea);
        }
        catch (Exception ex)
        {
            await ShowError(
                "Equipment loading failed.",
                ex.Message);
        }
    }


    // =========================================================
    // EQUIPMENT
    // =========================================================

    private async Task EquipmentChanged(
        ChangeEventArgs e)
    {
        selectedEquipment =
            e.Value?.ToString();

        selectedComponent = null;
        selectedComponentId = 0;

        components.Clear();

        ClearCalculation();

        if (string.IsNullOrWhiteSpace(
            selectedEquipment))
        {
            return;
        }

        try
        {
            components =
                await LiningService
                    .GetComponentsAsync(
                        selectedEquipment);
        }
        catch (Exception ex)
        {
            await ShowError(
                "Component loading failed.",
                ex.Message);
        }
    }


    // =========================================================
    // COMPONENT
    // =========================================================

    private Task ComponentChanged(
        ChangeEventArgs e)
    {
        selectedComponent =
            e.Value?.ToString();

        selectedComponentId = 0;

        if (decimal.TryParse(
            selectedComponent,
            out decimal compId))
        {
            selectedComponentId = compId;
        }

        ClearCalculation();

        return Task.CompletedTask;
    }


    // =========================================================
    // TYPE OF LINING
    // =========================================================

    private Task TypeLiningChanged(
        ChangeEventArgs e)
    {
        model.Lntype =
            e.Value?.ToString() ?? "";

        model.SIyear = 0;
        model.Dfb = "";

        dfbOptions.Clear();

        if (model.Lntype == "Organic")
        {
            lineAgeLabel = "Years in Service";

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Inspected More Than 6 Years Ago",
                    Value = "agosix"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Inspected within Last 6 Years",
                    Value = "sixyear"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Inspected within Last 3 Years",
                    Value = "threeyear"
                });
        }
        else if (model.Lntype == "Inorganic")
        {
            lineAgeLabel = "Years Last Inspection";

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Strip Lined Alloy(Resistant)",
                    Value = "Alloy"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Castable Refractory",
                    Value = "Castable"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Castable Refractory Severe Conditions",
                    Value = "Severe"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Glass Lined",
                    Value = "Glass"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Acid Brick",
                    Value = "Acid"
                });

            dfbOptions.Add(
                new LiningOption
                {
                    Text = "Fiberglass",
                    Value = "Fiber"
                });
        }

        // Legacy code creates 1 - 25
        liningAges =
            Enumerable.Range(1, 25)
                .ToList();

        ClearCalculation();

        return Task.CompletedTask;
    }


    // =========================================================
    // AGE
    // =========================================================

    // private Task AgeChanged(ChangeEventArgs e)
    // {
    //     if (int.TryParse(e.Value?.ToString(), out var age))
    //     {
    //         model.SIyear = age;
    //     }
    //     else
    //     {
    //         model.SIyear = 0;
    //     }

    //     ClearCalculation();

    //     return Task.CompletedTask;
    // }


    // =========================================================
    // DFB
    // =========================================================

    private Task DfbChanged(ChangeEventArgs e)
    {
        model.Dfb =
            e.Value?.ToString() ?? "";

        ClearCalculation();

        return Task.CompletedTask;
    }


    // =========================================================
    // LINING CONDITION
    // =========================================================

    private Task LiningConditionChanged(
        ChangeEventArgs e)
    {
        model.LnCond =
            e.Value?.ToString() ?? "";

        model.LnCondVal =
            model.LnCond switch
            {
                "Poor" => 10,
                "Average" => 2,
                "Good" => 1,
                _ => 0
            };

        liningConditionDescription =
            model.LnCond switch
            {
                "Poor" =>
                    "The lining has either had previous failures or exhibits conditions that may lead to failure in the near future. Repairs to previous failures are not successful or are of poor quality.",

                "Average" =>
                    "The lining is not showing signs of excessive attack by any damage mechanisms. Local repairs may have been performed, but they are of good quality and have successfully corrected the lining condition.",

                "Good" =>
                    "The lining is in 'like new' condition with no signs of attack by any damage mechanisms. There has been no need for any repairs to the lining.",

                _ => ""
            };

        ClearCalculation();

        return Task.CompletedTask;
    }


    // =========================================================
    // ONLINE MONITORING
    // =========================================================

    private Task OnlineMonitoringChanged(
        ChangeEventArgs e)
    {
        model.OnMoni =
            e.Value?.ToString() ?? "";

        model.OnMoniVal =
            model.OnMoni switch
            {
                "Yes" => 0.1m,
                "No" => 1.0m,
                _ => 0
            };

        ClearCalculation();

        return Task.CompletedTask;
    }


    // =========================================================
    // CALCULATE
    // =========================================================

    private async Task CalculateLining()
    {
        if (loading)
            return;

        // Validation
        if (selectedProcessArea <= 0)
        {
            await ShowWarning(
                "Please select Process Area.");
            return;
        }

        if (string.IsNullOrWhiteSpace(
            selectedEquipment))
        {
            await ShowWarning(
                "Please select Equipment.");
            return;
        }

        if (selectedComponentId <= 0)
        {
            await ShowWarning(
                "Please select Component.");
            return;
        }

        if (string.IsNullOrWhiteSpace(
            model.Lntype))
        {
            await ShowWarning(
                "Please select Type of Lining.");
            return;
        }

        if (model.SIyear <= 0)
        {
            await ShowWarning(
                "Please select Years.");
            return;
        }

        if (string.IsNullOrWhiteSpace(
            model.Dfb))
        {
            await ShowWarning(
                "Please select Dfb.");
            return;
        }

        if (string.IsNullOrWhiteSpace(
            model.LnCond))
        {
            await ShowWarning(
                "Please select Lining Condition.");
            return;
        }

        if (string.IsNullOrWhiteSpace(
            model.OnMoni))
        {
            await ShowWarning(
                "Please select Online Monitoring.");
            return;
        }

        try
        {
            loading = true;

            model.ProcID =
                selectedProcessArea;

            model.EquID =
                Convert.ToDecimal(
                    selectedEquipment);

            model.CompID =
                selectedComponentId;

            // =============================================
            // OLD LOGIC
            //
            // df = SELECT Dfb FROM Organic/Inorganic
            // Dfliner = df * LnCondVal * OnMoniVal
            // =============================================

            baseDfb =
                await LiningService.GetDfbValueAsync(
                    model.Lntype,
                    model.SIyear,
                    model.Dfb);

            model.DfLine =
                baseDfb *
                model.LnCondVal *
                model.OnMoniVal;

            calculated = true;

            await JS.InvokeVoidAsync(
                "sweetAlert.success",
                "Calculated!",
                "Lining damage factor calculated successfully.");
        }
        catch (Exception ex)
        {
            await ShowError(
                "Calculation failed.",
                ex.Message);
        }
        finally
        {
            loading = false;
        }
    }


    // =========================================================
    // LOAD EXISTING
    // =========================================================

    private async Task LoadExistingLining()
    {
        if (selectedProcessArea <= 0 ||
            string.IsNullOrWhiteSpace(
                selectedEquipment) ||
            selectedComponentId <= 0)
        {
            await ShowWarning(
                "Please select Process Area, Equipment and Component.");

            return;
        }

        try
        {
            loading = true;

            var record =
                await LiningService.GetLiningAsync(
                    selectedProcessArea,
                    Convert.ToDecimal(
                        selectedEquipment),
                    selectedComponentId);

            if (record == null)
            {
                model = new LiningDamageModel
                {
                    ProcID = selectedProcessArea,
                    EquID = Convert.ToDecimal(
                        selectedEquipment),
                    CompID = selectedComponentId
                };

                existingRecord = false;
                calculated = false;

                await JS.InvokeVoidAsync(
                    "sweetAlert.info",
                    "No Record",
                    "This component does not have a lining value. You can enter new data.");

                return;
            }

            model = record;

            existingRecord = true;

            // Rebuild type-dependent options
            BuildLiningOptions();

            liningConditionDescription =
                GetConditionDescription(
                    model.LnCond);

            // Recalculate base Dfb only for display
            baseDfb =
                await LiningService.GetDfbValueAsync(
                    model.Lntype,
                    model.SIyear,
                    model.Dfb);

            calculated = true;

            await JS.InvokeVoidAsync(
                "sweetAlert.success",
                "Loaded!",
                "Existing lining value loaded successfully.");
        }
        catch (Exception ex)
        {
            await ShowError(
                "Unable to load lining value.",
                ex.Message);
        }
        finally
        {
            loading = false;
        }
    }


    // =========================================================
    // SAVE
    // =========================================================

    private async Task SaveLining()
    {
        if (!calculated)
        {
            await ShowWarning(
                "Please calculate the Df Liner first.");

            return;
        }

        try
        {
            loading = true;

            model.ProcID =
                selectedProcessArea;

            model.EquID =
                Convert.ToDecimal(
                    selectedEquipment);

            model.CompID =
                selectedComponentId;

            decimal companyId =
                Convert.ToDecimal(
                    UserSession.CompanyID);

            decimal userId =
                Convert.ToDecimal(
                    UserSession.UserID);

            bool isNew =
                model.LnfID <= 0;

            await LiningService.SaveAsync(
                model,
                companyId,
                userId);

            existingRecord = true;

            await JS.InvokeVoidAsync(
                "sweetAlert.success",
                isNew ? "Saved!" : "Updated!",
                isNew
                    ? "Lining value inserted successfully."
                    : "Lining value updated successfully.");
        }
        catch (Exception ex)
        {
            await ShowError(
                "Save failed.",
                ex.Message);
        }
        finally
        {
            loading = false;
        }
    }


    // =========================================================
    // DELETE
    // =========================================================

    private async Task DeleteLining()
    {
        if (!existingRecord ||
            model.LnfID <= 0)
        {
            await ShowWarning(
                "No lining record selected.");

            return;
        }

        bool confirmed =
            await JS.InvokeAsync<bool>(
                "sweetAlert.confirmDelete",
                "Are you sure?",
                "Do you want to delete this lining value?",
                "");

        if (!confirmed)
            return;

        try
        {
            loading = true;

            decimal userId =
                Convert.ToDecimal(
                    UserSession.UserID);

            bool deleted =
                await LiningService.DeleteAsync(
                    model.LnfID,
                    userId);

            if (deleted)
            {
                await JS.InvokeVoidAsync(
                    "sweetAlert.success",
                    "Deleted!",
                    "Lining value deleted successfully.");

                ClearLining();
            }
            else
            {
                await ShowWarning(
                    "Lining record was not found.");
            }
        }
        catch (Exception ex)
        {
            await ShowError(
                "Delete failed.",
                ex.Message);
        }
        finally
        {
            loading = false;
        }
    }


    // =========================================================
    // BUILD OPTIONS
    // =========================================================

    private void BuildLiningOptions()
    {
        liningAges =
            Enumerable.Range(1, 25)
                .ToList();

        dfbOptions.Clear();

        if (model.Lntype == "Organic")
        {
            lineAgeLabel = "Years in Service";

            dfbOptions.Add(new LiningOption
            {
                Text = "Inspected More Than 6 Years Ago",
                Value = "agosix"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Inspected within Last 6 Years",
                Value = "sixyear"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Inspected within Last 3 Years",
                Value = "threeyear"
            });
        }
        else if (model.Lntype == "Inorganic")
        {
            lineAgeLabel = "Years Last Inspection";

            dfbOptions.Add(new LiningOption
            {
                Text = "Strip Lined Alloy(Resistant)",
                Value = "Alloy"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Castable Refractory",
                Value = "Castable"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Castable Refractory Severe Conditions",
                Value = "Severe"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Glass Lined",
                Value = "Glass"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Acid Brick",
                Value = "Acid"
            });

            dfbOptions.Add(new LiningOption
            {
                Text = "Fiberglass",
                Value = "Fiber"
            });
        }
    }


    // =========================================================
    // CLEAR CALCULATION
    // =========================================================

    private void ClearCalculation()
    {
        calculated = false;
        baseDfb = 0;
        model.DfLine = 0;
    }


    // =========================================================
    // CLEAR
    // =========================================================

    private void ClearLining()
    {
        model = new LiningDamageModel
        {
            ProcID = selectedProcessArea,

            EquID =
                decimal.TryParse(
                    selectedEquipment,
                    out var eq)
                    ? eq
                    : 0,

            CompID = selectedComponentId
        };

        existingRecord = false;
        calculated = false;

        baseDfb = 0;

        liningConditionDescription = "";

        BuildLiningOptions();
    }


    // =========================================================
    // DESCRIPTION
    // =========================================================

    private static string GetConditionDescription(
        string condition)
    {
        return condition switch
        {
            "Poor" =>
                "The lining has either had previous failures or exhibits conditions that may lead to failure in the near future. Repairs to previous failures are not successful or are of poor quality.",

            "Average" =>
                "The lining is not showing signs of excessive attack by any damage mechanisms. Local repairs may have been performed, but they are of good quality and have successfully corrected the lining condition.",

            "Good" =>
                "The lining is in 'like new' condition with no signs of attack by any damage mechanisms. There has been no need for any repairs to the lining.",

            _ => ""
        };
    }


    // =========================================================
    // FORMAT
    // =========================================================

    private static string FormatDecimal(
        decimal value)
    {
        return value.ToString("0.00");
    }


    // =========================================================
    // SWEET ALERT
    // =========================================================

    private async Task ShowWarning(
        string message)
    {
        await JS.InvokeVoidAsync(
            "sweetAlert.warning",
            "Warning!",
            message);
    }

    private async Task ShowError(
        string title,
        string message)
    {
        await JS.InvokeVoidAsync(
            "sweetAlert.error",
            title,
            message);
    }


    // =========================================================
    // OPTION MODEL
    // =========================================================

    private class LiningOption
    {
        public string Text { get; set; } = "";

        public string Value { get; set; } = "";
    }
