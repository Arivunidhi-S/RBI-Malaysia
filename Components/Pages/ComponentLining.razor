                    </div>


                    <!-- DFB -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Dfb
                            <span class="text-danger">*</span>
                        </label>

                        <select class="form-select"
                                value="@model.Dfb"
                                @onchange="DfbChanged"
                                disabled="@string.IsNullOrWhiteSpace(model.Lntype)">

                            <option value="">
                                -- Select --
                            </option>

                            @foreach (var item in dfbOptions)
                            {
                                <option value="@item.Value">
                                    @item.Text
                                </option>
                            }

                        </select>

                    </div>


                    <!-- LINING CONDITION -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Lining Condition
                            <span class="text-danger">*</span>
                        </label>

                        <select class="form-select"
                                value="@model.LnCond"
                                @onchange="LiningConditionChanged">

                            <option value="">
                                -- Select --
                            </option>

                            <option value="Poor">
                                Poor
                            </option>

                            <option value="Average">
                                Average
                            </option>

                            <option value="Good">
                                Good
                            </option>

                        </select>

                    </div>


                    <!-- DESCRIPTION -->
                    @if (!string.IsNullOrWhiteSpace(liningConditionDescription))
                    {
                        <div class="col-12">

                            <div class="lining-description">

