                        Calculate

                    </button>


                    <button type="button"
                            class="btn btn-success"
                            @onclick="SaveLining"
                            disabled="@(!calculated || loading)">

                        <i class="bi bi-save me-1"></i>

                        @(existingRecord ? "Update" : "Save")

                    </button>


                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="ClearLining">

                        <i class="bi bi-eraser me-1"></i>
                        Clear

                    </button>

                </div>


                <!-- ================================================= -->
                <!-- RESULT -->
                <!-- ================================================= -->
                @if (calculated)
                {

                <div class="staff-card-body">

                    <div class="row g-3">  

                        <div class="col-md-3">
                            <div class="inspection-summary">
                                <small>Base Dfb</small>
                                <strong>
                                    @FormatDecimal(baseDfb)
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="inspection-summary">
                                <small>Lining Condition</small>
                                <strong>
                                    @FormatDecimal(model.LnCondVal)
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="inspection-summary">
                            <small>Online Monitoring</small>
                            <strong>
                                @FormatDecimal(model.OnMoniVal)
                            </strong>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="inspection-summary">
