@page "/componentlining"

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using RBI_Malaysia.Components.Shared
@using Microsoft.JSInterop

@inject LiningDamageService LiningService
@inject UserSession UserSession
@inject IJSRuntime JS

<PageTitle>Component Lining</PageTitle>

<SessionGuard />

<div class="staff-page">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="staff-card mb-3">

        <div class="staff-card-header">

            <div>
                <h5 class="mb-0">
                    <i class="bi bi-layers me-2"></i>
                    Component Lining
                </h5>

                <small>
                    Component Lining Damage Factor
                </small>
            </div>

        </div>

        <div class="staff-card-body">

            <!-- ================================================= -->
            <!-- PROCESS AREA / EQUIPMENT / COMPONENT -->
            <!-- ================================================= -->

            <div class="row g-3">

                <!-- PROCESS AREA -->
                <div class="col-md-3">

                    <label class="form-label">
                        Process Area
                        <span class="text-danger">*</span>
                    </label>

                    <select class="form-select"
                            value="@selectedProcessArea"
                            @onchange="ProcessAreaChanged">

                        <option value="0">
                            -- Select Process Area --
                        </option>

                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">
                                @item.ProcessArea
                            </option>
                        }

                    </select>

                </div>


                <!-- EQUIPMENT -->
                <div class="col-md-3">

                    <label class="form-label">
                        Equipment
                        <span class="text-danger">*</span>
                    </label>

                    <select class="form-select"
                            value="@selectedEquipment"
                            @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">

                        <option value="">
                            -- Select Equipment --
                        </option>

                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">
                                @item.EquPID
                            </option>
                        }

                    </select>

                </div>


                <!-- COMPONENT -->
                <div class="col-md-3">

                    <label class="form-label">
                        Component
                        <span class="text-danger">*</span>
                    </label>

                    <select class="form-select"
                            value="@selectedComponent"
                            @onchange="ComponentChanged"
                            disabled="@string.IsNullOrWhiteSpace(selectedEquipment)">

                        <option value="">
                            -- Select Component --
                        </option>

                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">
                                @item.CompNo
                            </option>
                        }

                    </select>

                </div>


                <div class="col-md-3">
                    <div class="d-flex gap-2 mt-4 pt-2">

                        <button type="button"
                                class="btn btn-primary btn-sm"
                                @onclick="LoadExistingLining"
                                disabled="@loading">

                            <i class="bi bi-search me-1"></i>
                            Submit
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                @onclick="DeleteLining"
                                disabled="@(!existingRecord || loading)">

                            <i class="bi bi-trash me-1"></i>
                            Delete
                        </button>

                    </div>
                    </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- LINING DAMAGE FACTOR -->
    <!-- ===================================================== -->
    @* @if (selectedComponentId > 0)
    { *@
        <div class="staff-card">

            <div class="staff-card-header">

                <div>
                    <h6 class="mb-0">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        Component Lining Damage Factor
                    </h6>

                    <small>
                        Lining Damage Factor Calculation
                    </small>
                </div>

                

            </div>


            <div class="staff-card-body">

                <div class="row g-3">

                    <!-- TYPE OF LINING -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Type of Lining
                            <span class="text-danger">*</span>
                        </label>

                        <select class="form-select"
                                value="@model.Lntype"
                                @onchange="TypeLiningChanged">

                            <option value="">
                                -- Select --
                            </option>

                            <option value="Organic">
                                Organic
                            </option>

                            <option value="Inorganic">
                                Inorganic
                            </option>

                        </select>

                    </div>


