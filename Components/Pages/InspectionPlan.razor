@page "/inspection-plan"

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject InspectionPlanService PlanService
@inject UserSession UserSession
@inject IJSRuntime JS


<PageTitle>Inspection Plan</PageTitle>

<div class="staff-page">
    <div class="staff-card">

        <div class="staff-card-header">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-clipboard2-check me-2 text-success"></i>Inspection Plan
                </h5>
                <small>View and manage Inspection Plan records per Damage Mechanism</small>
            </div>
        </div>

        <div class="staff-card-body">

            <!-- Cascading Filters -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Process Area</label>
                    <select class="form-select" value="@selectedProcessArea" @onchange="ProcessAreaChanged">
                        <option value="0">-- Select Process Area --</option>
                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">@item.ProcessArea</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Equipment</label>
                    <select class="form-select" value="@selectedEquipment" @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">
                        <option value="0">-- Select Equipment --</option>
                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">@item.EquPID</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Component</label>
                    <select class="form-select" value="@selectedComponent" @onchange="ComponentChanged"
                            disabled="@(selectedEquipment <= 0)">
                        <option value="0">-- Select Component --</option>
                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">@item.CompNo</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Add / Edit Form -->
            <div class="border rounded p-3 mb-4 bg-light">
                <h6 class="fw-bold mb-3 text-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    @(isEditing ? "Edit Inspection Plan" : "Add Inspection Plan")
                </h6>
                <EditForm Model="@form" OnValidSubmit="SaveForm" FormName="InspectionPlanForm">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Damage Mechanism <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="form.DamageFact" @bind:after="OnDamageOrCateChanged"
                                    disabled="@isEditing">
                                <option value="">Select</option>
                                @foreach (var d in InspectionPlanService.DamageFactorOptions)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Insp. Category <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="form.InspectCate" @bind:after="OnDamageOrCateChanged">
                                <option value="">Select</option>
                                <option value="A">A — Highly Effective</option>
                                <option value="B">B — Usually Effective</option>
                                <option value="C">C — Fairly Effective</option>
                                <option value="D">D — Poorly Effective</option>
                                <option value="E">E — In Effective</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Inspection Date</label>
                            <InputDate class="form-control" @bind-Value="form.InspectDate" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-secondary fw-bold">Effectiveness</label>
                            <input type="text" class="form-control" value="@form.InsEffCate" readonly />
                        </div>

                        <!-- Intrusive / Non-Intrusive -->
                        <div class="col-12">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary fw-bold">Intrusive Inspection</label>
                                    <textarea class="form-control" rows="2" readonly>@form.IntrInsp</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary fw-bold">Non-Intrusive Inspection</label>
                                    <textarea class="form-control" rows="2" readonly>@form.NonIntrInsp</textarea>
                                </div>
                            </div>
                        </div>

                        <div class="staff-buttons col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-success fw-bold" disabled="@isSaving">
                                @(isSaving ? "Saving..." : (isEditing ? "Update" : "Save"))
                            </button>
                            @if (isEditing)
                            {
                                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary" @onclick="ClearForm">Clear</button>
                            }
                        </div>
                    </div>
                </EditForm>
            </div>

            <!-- Records List -->
            @if (isLoading)
            {
                <p class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Loading...</p>
            }
            else if (rows.Count == 0 && selectedProcessArea > 0)
            {
                <p class="text-muted">No Inspection Plan records found for the selected filter.</p>
            }
            else if (rows.Count > 0)
            {
                <!-- Search + page size -->
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Show</span>
                        <select class="form-select form-select-sm" style="width:80px"
                                value="@pageSize" @onchange="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <span class="text-muted small">records</span>
                    </div>
                    <input type="text" class="form-control form-control-sm" style="width:220px"
                           placeholder="Search..." value="@searchText" @oninput="OnSearchInput" />
                </div>

                <div class="table-responsive" @key="renderKey">
                    <table class="table table-hover staff-table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Process Area</th>
                                <th>Equipment</th>
                                <th>Component</th>
                                <th>Damage Mechanism</th>
                                <th>Insp. Category</th>
                                <th>Effectiveness</th>
                                <th>Inspect Date</th>
                                <th>Intrusive Inspection</th>
                                <th>Non-Intrusive Inspection</th>
                                <th>Edit</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = (currentPage - 1) * pageSize + 1; }
                            @foreach (var row in PagedRows)
                            {
                                var r = row;
                                <tr>
                                    <td>@i</td>
                                    <td>@r.ProcessArea</td>
                                    <td>@r.EquipmentName</td>
                                    <td>@r.ComponentName</td>
                                    <td><span class="badge bg-primary">@r.DamageFact</span></td>
                                    <td class="fw-bold">@r.InspectCate</td>
                                    <td>@r.InsEffCate</td>
                                    <td>@r.InspectDate?.ToString("dd-MMM-yyyy")</td>
                                    <td style="white-space:pre-wrap;max-width:200px;font-size:12px">@r.IntrInsp</td>
                                    <td style="white-space:pre-wrap;max-width:200px;font-size:12px">@r.NonIntrInsp</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" style="width:40px" @onclick="() => EditRow(r)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" style="width:40px" @onclick="() => DeleteRow(r)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                        <div class="text-muted small">
                            Showing @(Math.Min((currentPage-1)*pageSize+1, FilteredRows.Count()))
                            to @(Math.Min(currentPage*pageSize, FilteredRows.Count()))
                            of @FilteredRows.Count() records
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage==1?"disabled":"")">
                                    <button class="page-link" @onclick="()=>GoToPage(1)">«</button>
                                </li>
                                <li class="page-item @(currentPage==1?"disabled":"")">
                                    <button class="page-link" @onclick="()=>GoToPage(currentPage-1)">‹</button>
                                </li>
                                @foreach (var p in GetPageNumbers())
                                {
                                    var pg = p;
                                    <li class="page-item @(pg==currentPage?"active":"")">
                                        <button class="page-link" @onclick="()=>GoToPage(pg)">@pg</button>
                                    </li>
                                }
                                <li class="page-item @(currentPage==TotalPages?"disabled":"")">
                                    <button class="page-link" @onclick="()=>GoToPage(currentPage+1)">›</button>
                                </li>
                                <li class="page-item @(currentPage==TotalPages?"disabled":"")">
                                    <button class="page-link" @onclick="()=>GoToPage(TotalPages)">»</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }

        </div>
    </div>
</div>

@code
{
    private InspectionPlanModel form = new();
    private decimal selectedProcessArea, selectedEquipment, selectedComponent;

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel>   equipments   = new();
    private List<ComponentModel>   components   = new();
    private List<InspectionPlanModel> rows       = new();

    private bool isLoading, isSaving, isEditing;
    private int renderKey;

    // Pagination & Search
    private string searchText = "";
    private int pageSize = 10, currentPage = 1;

    private IEnumerable<InspectionPlanModel> FilteredRows =>
        string.IsNullOrWhiteSpace(searchText)
            ? rows
            : rows.Where(r =>
                (r.DamageFact?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.ComponentName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.EquipmentName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.InsEffCate?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private int TotalPages => (int)Math.Ceiling(FilteredRows.Count() / (double)pageSize);
    private IEnumerable<InspectionPlanModel> PagedRows =>
        FilteredRows.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        processAreas = await PlanService.GetProcessAreasAsync(UserSession.CompanyID);
    }

    private async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedEquipment = 0; selectedComponent = 0;
        equipments.Clear(); components.Clear(); rows.Clear();
        if (selectedProcessArea > 0)
            equipments = await PlanService.GetEquipmentsByProcessAsync(selectedProcessArea);
        await LoadData();
    }

    private async Task EquipmentChanged(ChangeEventArgs e)
    {
        selectedEquipment = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedComponent = 0;
        components.Clear(); rows.Clear();
        if (selectedEquipment > 0)
            components = await PlanService.GetComponentsByEquipmentAsync(selectedEquipment.ToString());
        await LoadData();
    }

    private async Task ComponentChanged(ChangeEventArgs e)
    {
        selectedComponent = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        // Auto-set form IDs for new record
        form.ProcID = selectedProcessArea; form.EquID = selectedEquipment; form.CompID = selectedComponent;
        await LoadData();
    }

    private async Task LoadData()
    {
        if (selectedProcessArea <= 0) { rows.Clear(); return; }
        isLoading = true; StateHasChanged();
        try
        {
            rows = await PlanService.GetInspectionPlansAsync(selectedProcessArea, selectedEquipment, selectedComponent);
            currentPage = 1; searchText = ""; renderKey++;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Error!", text = ex.Message, icon = "error" });
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    // Auto-lookup InspectEffect when Damage Mechanism or Category changes
    private async Task OnDamageOrCateChanged()
    {
        if (string.IsNullOrEmpty(form.DamageFact) || string.IsNullOrEmpty(form.InspectCate)) return;
        try
        {
            var (eff, intr, nonIntr) = await PlanService.GetInspectEffectAsync(form.DamageFact, form.InspectCate);
            form.InsEffCate = eff; form.IntrInsp = intr; form.NonIntrInsp = nonIntr;
        }
        catch { }
    }

    private async Task SaveForm()
    {
        if (selectedComponent <= 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Warning", text = "Please select a Component first.", icon = "warning" });
            return;
        }
        isSaving = true; StateHasChanged();
        try
        {
            form.ProcID = selectedProcessArea; form.EquID = selectedEquipment; form.CompID = selectedComponent;
            await PlanService.SaveInspectionPlanAsync(form);
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Saved!", text = "Inspection Plan saved successfully.", icon = "success",
                      timer = 2000, showConfirmButton = false });
            CancelEdit();
            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Save Error", text = ex.Message, icon = "error" });
        }
        finally { isSaving = false; StateHasChanged(); }
    }

    private void EditRow(InspectionPlanModel row)
    {
        form = new InspectionPlanModel
        {
            InspectID   = row.InspectID,
            ProcID      = row.ProcID,
            EquID       = row.EquID,
            CompID      = row.CompID,
            DamageFact  = row.DamageFact,
            InspectCate = row.InspectCate,
            InspectDate = row.InspectDate,
            InsEffCate  = row.InsEffCate,
            IntrInsp    = row.IntrInsp,
            NonIntrInsp = row.NonIntrInsp,
        };
        isEditing = true;
    }

    private async Task DeleteRow(InspectionPlanModel row)
    {
        // bool confirm = await JS.InvokeAsync<bool>("Swal.fire", new
        // {
        //     title = "Delete Record?",
        //     text = $"{row.DamageFact} Inspection Plan for {row.ComponentName} will be deleted.",
        //     icon = "warning",
        //     showCancelButton = true,
        //     confirmButtonColor = "#d33",
        //     cancelButtonColor = "#6c757d",
        //     confirmButtonText = "Yes, delete it!",
        //     cancelButtonText = "Cancel"
        // }).ContinueWith(t => t.Result.GetProperty("isConfirmed").GetBoolean());

        bool confirmed =
         await JS.InvokeAsync<bool>("sweetAlert.confirmDelete", "Are you sure?", $"Do you want to delete this {row.DamageFact} Inspection Plan for {row.ComponentName}?");


        if (!confirmed) return;
        try
        {
            await PlanService.DeleteInspectionPlanAsync(row.InspectID);
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Deleted!", text = "Record has been deleted.", icon = "success",
                      timer = 1800, showConfirmButton = false });
            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Delete Error", text = ex.Message, icon = "error" });
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        ClearForm();
    }

    private void ClearForm()
    {
        form = new InspectionPlanModel
        {
            ProcID = selectedProcessArea,
            EquID  = selectedEquipment,
            CompID = selectedComponent
        };
    }

    private void OnSearchInput(ChangeEventArgs e) { searchText = e.Value?.ToString() ?? ""; currentPage = 1; }
    private void OnPageSizeChanged(ChangeEventArgs e) { pageSize = int.TryParse(e.Value?.ToString(), out var v) ? v : 10; currentPage = 1; }
    private void GoToPage(int page) { if (page >= 1 && page <= TotalPages) currentPage = page; }
    private IEnumerable<int> GetPageNumbers()
    {
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(TotalPages, currentPage + 2);
        for (int i = start; i <= end; i++) yield return i;
    }
}
