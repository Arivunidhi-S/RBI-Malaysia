@page "/pof-scc-hf"
@layout StaffLayout

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HfService HfSvc
@inject UserSession UserSession
@inject IJSRuntime JS

<PageTitle>POF — SCC HIC/SOHIC-HF Cracking</PageTitle>

<div class="staff-page">
    <div class="staff-card">
        <div class="staff-card-header">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-diamond me-2 text-warning"></i> SCC — HIC/SOHIC-HF Cracking
                </h5>
                <small>SCCDF HIC/SOHIC — Hydrofluoric Acid (HF) Damage Factor Calculation</small>
            </div>
        </div>

        <div class="staff-card-body">

            <!-- Cascading Filters (replaces cboProcessArea / cboEquipment / cboComponent) -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Process Area <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedProcessArea" @onchange="ProcessAreaChanged">
                        <option value="0">-- Select Process Area --</option>
                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">@item.ProcessArea</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Equipment <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedEquipment" @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">
                        <option value="0">-- Select Equipment --</option>
                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">@item.EquPID</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Component <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedComponent" @onchange="ComponentChanged"
                            disabled="@(selectedEquipment <= 0)">
                        <option value="0">-- Select Component --</option>
                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">@item.CompNo</option>
                        }
                    </select>
                </div>
            </div>

            <EditForm Model="@model" FormName="HfForm">
                <DataAnnotationsValidator />

                <h6 class="text-muted border-bottom pb-1 mb-3">Basic Inputs</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Age <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="model.HfAge" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Effectiveness <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.HfInsEff">
                            <option value="">Select</option>
                            <option value="A">A — Highly Effective</option>
                            <option value="B">B — Usually Effective</option>
                            <option value="C">C — Fairly Effective</option>
                            <option value="D">D — Poorly Effective</option>
                            <option value="E">E — In Effective</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. of Inspections <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.HfNofIns">
                            <option value="">Select</option>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Date</label>
                        <InputDate class="form-control" @bind-Value="model.InspectDate" />
                    </div>
                </div>

                <!-- PWHT + Construction material -> Svi -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Susceptibility & Svi</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">PWHT</label>
                        <select class="form-select" @bind="model.PwhtCode" @bind:after="RecalcSvi">
                            <option value="">Select</option>
                            @foreach (var opt in HfSvc.PwhtOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Construction Material</label>
                        <select class="form-select" @bind="model.MaterialCode" @bind:after="OnMaterialChanged">
                            <option value="">Select</option>
                            @foreach (var opt in HfSvc.MaterialOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-bold">Susceptibility / Svi (auto)</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-primary"
                               value="@model.HfSvi" readonly />
                    </div>
                    <div class="col-md-3 d-flex align-items-end pb-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="hfKnownCrack"
                                   checked="@model.KnownCrack" @onchange="OnKnownCrackChanged" />
                            <label class="form-check-label fw-bold text-danger" for="hfKnownCrack">
                                Known Cracking Present<br />
                                <small class="text-muted fw-normal">(overrides Svi to "High")</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Result -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Result</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-secondary fw-bold">Df — SOHIC (HF)</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-danger"
                               value="@model.HfDf" readonly />
                    </div>
                </div>

                <!-- Buttons: separate Calculate / Save (legacy btn_HF_Calc / btn_HF_Save) -->
                <div class="staff-buttons mt-4 d-flex gap-2">
                    <button type="button" class="btn btn-info text-white"
                            @onclick="Calculate" disabled="@isCalculating">
                        @(isCalculating ? "Calculating..." : "Calculate")
                    </button>
                    <button type="button" class="btn btn-success"
                            @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Clear</button>
                    @if (hasExistingData)
                    {
                        <button type="button" class="btn btn-danger" @onclick="DeleteRecord">Delete</button>
                    }
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code
{
    private HfModel model = new();
    private decimal selectedProcessArea, selectedEquipment, selectedComponent;

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel>   equipments   = new();
    private List<ComponentModel>   components   = new();

    private bool hasExistingData, isSaving, isCalculating;

    protected override async Task OnInitializedAsync() =>
        processAreas = await HfSvc.GetProcessAreasAsync(UserSession.CompanyID);

    private async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedEquipment = 0; selectedComponent = 0;
        equipments.Clear(); components.Clear();
        model = new(); hasExistingData = false;
        if (selectedProcessArea > 0)
            equipments = await HfSvc.GetEquipmentsByProcessAsync(selectedProcessArea);
    }

    private async Task EquipmentChanged(ChangeEventArgs e)
    {
        selectedEquipment = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedComponent = 0;
        components.Clear();
        model = new(); hasExistingData = false;
        if (selectedEquipment > 0)
            components = await HfSvc.GetComponentsByEquipmentAsync(selectedEquipment.ToString());
    }

    private async Task ComponentChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal id)) return;
        selectedComponent = id;
        try
        {
            var existing = await HfSvc.GetHfRecordAsync(selectedProcessArea, selectedEquipment, id);
            if (existing != null) { model = existing; hasExistingData = true; }
            else
            {
                model = new() { ProcID = selectedProcessArea, EquID = selectedEquipment, CompID = id };
                hasExistingData = false;
            }
        }
        catch (Exception ex)
        {
            await ShowError("Load Error", ex.Message);
        }
    }

    // Legacy only recalculated Svi when material changed (and unchecked "known cracking");
    // PWHT changes now recalculate too once both are selected.
    private async Task OnMaterialChanged()
    {
        model.KnownCrack = false;
        await RecalcSvi();
    }

    // PWHT + Construction material -> Svi
    private async Task RecalcSvi()
    {
        if (string.IsNullOrEmpty(model.PwhtCode) || string.IsNullOrEmpty(model.MaterialCode)) return;
        if (model.KnownCrack) return;   // override in effect
        try
        {
            model.HfSvi  = await HfSvc.ComputeSviAsync(model.PwhtCode, model.MaterialCode);
            model.HfDf   = string.Empty;   // result is stale once Svi changes
            model.Pwht    = HfSvc.PwhtOptions.Find(o => o.Code == model.PwhtCode)?.Label ?? "";
            model.Material = HfSvc.MaterialOptions.Find(o => o.Code == model.MaterialCode)?.Label ?? "";
        }
        catch (Exception ex)
        {
            await ShowError("Error", ex.Message);
        }
    }

    // Known cracking checkbox (legacy chk_HF_known_CheckedChanged)
    private async Task OnKnownCrackChanged(ChangeEventArgs e)
    {
        model.KnownCrack = e.Value is bool b && b;
        model.HfDf = string.Empty;
        if (model.KnownCrack) model.HfSvi = "High";
        else await RecalcSvi();
    }

    private async Task Calculate()
    {
        isCalculating = true; StateHasChanged();
        try { model = await HfSvc.CalculateHfAsync(model); }
        catch (Exception ex) { await ShowError("Calculate Error", ex.Message); }
        finally { isCalculating = false; StateHasChanged(); }
    }

    private async Task Save()
    {
        isSaving = true; StateHasChanged();
        try
        {
            model = await HfSvc.SaveHfAsync(model);
            hasExistingData = true;
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Saved!", text = "HIC/SOHIC-HF record saved successfully.", icon = "success", timer = 2000, showConfirmButton = false });
        }
        catch (Exception ex) { await ShowError("Save Error", ex.Message); }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task DeleteRecord()
    {
        bool confirmed = await JS.InvokeAsync<bool>("sweetAlert.confirmDelete",
            "Are you sure?", "Do you want to delete this HIC/SOHIC-HF record?");
        if (!confirmed) return;
        try
        {
            await HfSvc.DeleteHfAsync(model.ProcID, model.EquID, model.CompID);
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Deleted!", text = "Record has been deleted.", icon = "success", timer = 1800, showConfirmButton = false });
            ClearForm();
        }
        catch (Exception ex) { await ShowError("Delete Error", ex.Message); }
    }

    private void ClearForm()
    {
        model = new();
        selectedProcessArea = selectedEquipment = selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
    }

    private Task ShowError(string title, string text) =>
        JS.InvokeVoidAsync("Swal.fire", new { title, text, icon = "error" }).AsTask();
}
