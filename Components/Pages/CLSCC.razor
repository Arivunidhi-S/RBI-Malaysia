@page "/pof-scc-clscc"

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject CarbonateService CarbonateService
@inject UserSession UserSession
@inject IJSRuntime JS
@inject NavigationManager Nav


<PageTitle>POF — CLSCC</PageTitle>

<div class="staff-page">

    <!-- SCC Top Navigation Menu -->
    @layout StaffLayout
    <div class="staff-card">
        <div class="staff-card-header">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-water me-2 text-info"></i> SCC — CLSCC
                </h5>
                <small>SCCDF CLSCC Factor Calculation</small>
            </div>
        </div>

        <div class="staff-card-body">

            <!-- Cascading Filters -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Process Area <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedProcessArea" @onchange="ProcessAreaChanged">
                        <option value="0">-- Select Process Area --</option>
                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">@item.ProcessArea</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Equipment <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedEquipment" @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">
                        <option value="0">-- Select Equipment --</option>
                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">@item.EquPID</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Component <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedComponent" @onchange="ComponentChanged"
                            disabled="@(selectedEquipment <= 0)">
                        <option value="0">-- Select Component --</option>
                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">@item.CompNo</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Input Form -->
            <EditForm Model="@model" OnValidSubmit="Calculate" FormName="CarbonateForm">
                <DataAnnotationsValidator />

                <h6 class="text-muted border-bottom pb-1 mb-3">Basic Inputs</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Age <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="model.CO3Age" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Effectiveness <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.CO3InsEff">
                            <option value="">Select</option>
                            <option value="A">A — Highly Effective</option>
                            <option value="B">B — Usually Effective</option>
                            <option value="C">C — Fairly Effective</option>
                            <option value="D">D — Poorly Effective</option>
                            <option value="E">E — In Effective</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. of Inspections <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.CO3nofIns">
                            <option value="">Select</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Date</label>
                        <InputDate class="form-control" @bind-Value="model.InspectDate" />
                    </div>
                </div>

                <!-- Step 1: pH + CO3 → Svi -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Susceptibility (STEP 1)</h6>
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">pH of Water</label>
                        <select class="form-select" @bind="model.PHwaterCode" @bind:after="RecalcSvi">
                            <option value="">Select</option>
                            @foreach (var opt in CarbonateService.PHOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Chloride(ppm)</label>
                        <select class="form-select" @bind="model.CO3Code" @bind:after="RecalcSvi">
                            <option value="">Select</option>
                            @foreach (var opt in CarbonateService.CO3Options)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-bold">Svi (auto)</label>
                        <input type="text" class="form-control fw-bold text-primary bg-warning-subtle" value="@model.CO3Svi" readonly />
                    </div>
                    <div class="col-md-3 pb-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="knownCrack"
                                   checked="@model.KnownCrack" @onchange="OnKnownCrackChanged" />
                            <label class="form-check-label fw-bold text-danger" for="knownCrack">
                                Known Cracking Present<br />
                                <small class="text-muted fw-normal">(overrides Svi to "High")</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Result -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Result</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-secondary fw-bold">Df — CLSCC</label>
                        <input type="text" class="form-control fw-bold text-info bg-warning-subtle" value="@model.CO3Df" readonly />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="staff-buttons mt-4 d-flex gap-2">
                    <button type="button" class="btn btn-info text-white fw-bold"
                            @onclick="Calculate" disabled="@isCalculating">
                        @(isCalculating ? "Calculating..." : "Calculate")
                    </button>
                    <button type="button" class="btn btn-success fw-bold"
                            @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Clear</button>
                    @if (hasExistingData)
                    {
                        <button type="button" class="btn btn-danger" @onclick="DeleteRecord">Delete</button>
                    }
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code
{
    private CarbonateModel model = new();
    private decimal selectedProcessArea, selectedEquipment, selectedComponent;

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel>   equipments   = new();
    private List<ComponentModel>   components   = new();

    private bool hasExistingData, isSaving, isCalculating;

    protected override async Task OnInitializedAsync() =>
        processAreas = await CarbonateService.GetProcessAreasAsync(UserSession.CompanyID);

    private async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedEquipment = 0; selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
        if (selectedProcessArea > 0)
            equipments = await CarbonateService.GetEquipmentsByProcessAsync(selectedProcessArea);
    }

    private async Task EquipmentChanged(ChangeEventArgs e)
    {
        selectedEquipment = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedComponent = 0;
        components.Clear();
        hasExistingData = false;
        if (selectedEquipment > 0)
            components = await CarbonateService.GetComponentsByEquipmentAsync(selectedEquipment.ToString());
    }

    private async Task ComponentChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal id)) return;
        selectedComponent = id;
        try
        {
            var existing = await CarbonateService.GetCarbonateRecordAsync(selectedProcessArea, selectedEquipment, id);
            if (existing != null) { model = existing; hasExistingData = true; }
            else { model = new() { ProcID = selectedProcessArea, EquID = selectedEquipment, CompID = id }; hasExistingData = false; }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Load Error", text = ex.Message, icon = "error" });
        }
    }

    // pH or CO3 changed → auto-compute Svi via Ref_CO3
    private async Task RecalcSvi()
    {
        if (string.IsNullOrEmpty(model.PHwaterCode) || string.IsNullOrEmpty(model.CO3Code)) return;
        if (model.KnownCrack) return;
        try
        {
            model.CO3Svi = await CarbonateService.ComputeSviAsync(model.CO3Code, model.PHwaterCode);
            model.PHwater = CarbonateService.PHOptions.Find(o => o.Code == model.PHwaterCode).Label;
            model.CO3     = CarbonateService.CO3Options.Find(o => o.Code == model.CO3Code).Label;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Error", text = ex.Message, icon = "error" });
        }
    }

    private async Task OnKnownCrackChanged(ChangeEventArgs e)
    {
        model.KnownCrack = (bool)(e.Value ?? false);
        if (model.KnownCrack)
        {
            model.CO3Svi = "High";
        }
        else
        {
            await RecalcSvi();
        }
    }

    private async Task Calculate()
    {
        isCalculating = true; StateHasChanged();
        try { model = await CarbonateService.CalculateCarbonateAsync(model); }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Calculate Error", text = ex.Message, icon = "error" });
        }
        finally { isCalculating = false; StateHasChanged(); }
    }

    private async Task Save()
    {
        isSaving = true; StateHasChanged();
        try
        {
            model = await CarbonateService.SaveCarbonateAsync(model);
            hasExistingData = true;
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Saved!", text = "Carbonate Cracking record saved successfully.", icon = "success", timer = 2000, showConfirmButton = false });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Save Error", text = ex.Message, icon = "error" });
        }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task DeleteRecord()
    {
        // bool confirm = await JS.InvokeAsync<bool>("Swal.fire", new
        // {
        //     title = "Delete Record?",
        //     text = "This Carbonate Cracking record will be permanently deleted.",
        //     icon = "warning",
        //     showCancelButton = true,
        //     confirmButtonColor = "#d33",
        //     cancelButtonColor = "#6c757d",
        //     confirmButtonText = "Yes, delete it!",
        //     cancelButtonText = "Cancel"
        // }).ContinueWith(t => t.Result.GetProperty("isConfirmed").GetBoolean());

        bool confirmed =
            await JS.InvokeAsync<bool>("sweetAlert.confirmDelete", "Are you sure?", $"Do you want to delete this Carbonate Cracking record?");

        if (!confirmed) return;
        try
        {
            await CarbonateService.DeleteCarbonateAsync(model.ProcID, model.EquID, model.CompID);
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Deleted!", text = "Record has been deleted.", icon = "success", timer = 1800, showConfirmButton = false });
            ClearForm();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Delete Error", text = ex.Message, icon = "error" });
        }
    }

    private void ClearForm()
    {
        model = new();
        selectedProcessArea = selectedEquipment = selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
    }
}
