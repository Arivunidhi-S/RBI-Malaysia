@page "/pof-scc-hic"
@layout StaffLayout

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HicSohicService HicService
@inject UserSession UserSession
@inject IJSRuntime JS

<PageTitle>POF — SCC HIC/SOHIC-H2S Cracking</PageTitle>

<div class="staff-page">
    <div class="staff-card">
        <div class="staff-card-header">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-wind me-2 text-warning"></i> SCC — HIC/SOHIC-H2S Cracking
                </h5>
                <small>SCCDF HIC/SOHIC-H2S Damage Factor Calculation</small>
            </div>
        </div>

        <div class="staff-card-body">

            <!-- Cascading Filters (replaces cboProcessArea / cboEquipment / cboComponent) -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Process Area <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedProcessArea" @onchange="ProcessAreaChanged">
                        <option value="0">-- Select Process Area --</option>
                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">@item.ProcessArea</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Equipment <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedEquipment" @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">
                        <option value="0">-- Select Equipment --</option>
                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">@item.EquPID</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Component <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedComponent" @onchange="ComponentChanged"
                            disabled="@(selectedEquipment <= 0)">
                        <option value="0">-- Select Component --</option>
                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">@item.CompNo</option>
                        }
                    </select>
                </div>
            </div>

            <EditForm Model="@model" FormName="HicSohicForm">
                <DataAnnotationsValidator />

                <h6 class="text-muted border-bottom pb-1 mb-3">Basic Inputs</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Age <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="model.HicAge" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Effectiveness <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.HicInsEff">
                            <option value="">Select</option>
                            <option value="A">A — Highly Effective</option>
                            <option value="B">B — Usually Effective</option>
                            <option value="C">C — Fairly Effective</option>
                            <option value="D">D — Poorly Effective</option>
                            <option value="E">E — In Effective</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. of Inspections <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.HicnofIns">
                            <option value="">Select</option>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Date</label>
                        <InputDate class="form-control" @bind-Value="model.InspectDate" />
                    </div>
                </div>

                <!-- Step 1: pH + H2S content -> Environmental Severity -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Environmental Severity (STEP 1)</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">pH of Water</label>
                        <select class="form-select" @bind="model.PHwaterCode" @bind:after="RecalcEnvSeverity">
                            <option value="">Select</option>
                            @foreach (var opt in HicService.PHOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">H2S Content in Water</label>
                        <select class="form-select" @bind="model.H2SCode" @bind:after="RecalcEnvSeverity">
                            <option value="">Select</option>
                            @foreach (var opt in HicService.H2SOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-bold">Environmental Severity (auto)</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-danger"
                               value="@model.Severity" readonly />
                    </div>
                </div>

                <!-- Step 2: Heat treatment + Steel sulfur + Severity -> Svi -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Susceptibility & Svi (STEP 2)</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Heat Treatment</label>
                        <select class="form-select" @bind="model.HeatCode" @bind:after="RecalcSvi">
                            <option value="">Select</option>
                            @foreach (var opt in HicService.HeatOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Steel Sulfur</label>
                        <select class="form-select" @bind="model.SteelSulfurCode" @bind:after="OnSteelChanged">
                            <option value="">Select</option>
                            @foreach (var opt in HicService.SteelSulfurOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-bold">Susceptibility / Svi (auto)</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-primary"
                               value="@model.HicSvi" readonly />
                    </div>

                    <!-- Step 3: Known cracking override -->
                    <div class="col-md-3 d-flex align-items-end pb-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="hicKnownCrack"
                                   checked="@model.KnownCrack" @onchange="OnKnownCrackChanged" />
                            <label class="form-check-label fw-bold text-danger" for="hicKnownCrack">
                                Known Cracking Present<br />
                                <small class="text-muted fw-normal">(overrides Svi to "High")</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Result -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Result</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-secondary fw-bold">Df — SOHIC</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-danger"
                               value="@model.HicDfSOHIC" readonly />
                    </div>
                </div>

                <!-- Buttons: separate Calculate / Save (legacy btn_HIC_Calc / btn_HIC_Save) -->
                <div class="staff-buttons mt-4 d-flex gap-2">
                    <button type="button" class="btn btn-info text-white"
                            @onclick="Calculate" disabled="@isCalculating">
                        @(isCalculating ? "Calculating..." : "Calculate")
                    </button>
                    <button type="button" class="btn btn-success"
                            @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Clear</button>
                    @if (hasExistingData)
                    {
                        <button type="button" class="btn btn-danger" @onclick="DeleteRecord">Delete</button>
                    }
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code
{
    private HicSohicModel model = new();
    private decimal selectedProcessArea, selectedEquipment, selectedComponent;

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel>   equipments   = new();
    private List<ComponentModel>   components   = new();

    private bool hasExistingData, isSaving, isCalculating;

    protected override async Task OnInitializedAsync() =>
        processAreas = await HicService.GetProcessAreasAsync(UserSession.CompanyID);

    private async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedEquipment = 0; selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
        if (selectedProcessArea > 0)
            equipments = await HicService.GetEquipmentsByProcessAsync(selectedProcessArea);
    }

    private async Task EquipmentChanged(ChangeEventArgs e)
    {
        selectedEquipment = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedComponent = 0;
        components.Clear();
        hasExistingData = false;
        if (selectedEquipment > 0)
            components = await HicService.GetComponentsByEquipmentAsync(selectedEquipment.ToString());
    }

    private async Task ComponentChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal id)) return;
        selectedComponent = id;
        try
        {
            var existing = await HicService.GetHicRecordAsync(selectedProcessArea, selectedEquipment, id);
            if (existing != null) { model = existing; hasExistingData = true; }
            else
            {
                model = new() { ProcID = selectedProcessArea, EquID = selectedEquipment, CompID = id };
                hasExistingData = false;
            }
        }
        catch (Exception ex)
        {
            await ShowError("Load Error", ex.Message);
        }
    }

    // STEP 1 — pH + H2S changed -> Environmental Severity (legacy OnSelectedIndexChanged_HIC)
    private async Task RecalcEnvSeverity()
    {
        if (string.IsNullOrEmpty(model.PHwaterCode) || string.IsNullOrEmpty(model.H2SCode)) return;
        try
        {
            model.Severity = await HicService.ComputeEnvSeverityAsync(model.H2SCode, model.PHwaterCode);
            model.PHwater  = HicService.PHOptions.Find(o => o.Code == model.PHwaterCode)?.Label ?? "";
            model.H2S      = HicService.H2SOptions.Find(o => o.Code == model.H2SCode)?.Label ?? "";
            await RecalcSvi();   // cascade if heat + steel sulfur already chosen
        }
        catch (Exception ex)
        {
            await ShowError("Error", ex.Message);
        }
    }

    // STEP 2 — Heat + Steel Sulfur + Severity -> Svi (legacy OnSelectedIndexChanged_SteelSul)
    private async Task RecalcSvi()
    {
        if (string.IsNullOrEmpty(model.SteelSulfurCode) || string.IsNullOrEmpty(model.HeatCode)
            || string.IsNullOrEmpty(model.Severity)) return;
        if (model.KnownCrack) return;   // override in effect
        try
        {
            model.HicSvi      = await HicService.ComputeSviAsync(model.SteelSulfurCode, model.HeatCode, model.Severity);
            model.HicDfSOHIC  = string.Empty;   // result is stale once Svi changes
            model.Heat        = HicService.HeatOptions.Find(o => o.Code == model.HeatCode)?.Label ?? "";
            model.SteelSulfur = HicService.SteelSulfurOptions.Find(o => o.Code == model.SteelSulfurCode)?.Label ?? "";
        }
        catch (Exception ex)
        {
            await ShowError("Error", ex.Message);
        }
    }

    // Legacy OnSelectedIndexChanged_SteelSul unchecked "known cracking" before recalculating Svi
    private async Task OnSteelChanged()
    {
        model.KnownCrack = false;
        await RecalcSvi();
    }

    // STEP 3 — Known cracking checkbox (legacy chk_HIC_known_CheckedChanged)
    private async Task OnKnownCrackChanged(ChangeEventArgs e)
    {
        model.KnownCrack = e.Value is bool b && b;
        model.HicDfSOHIC = string.Empty;
        if (model.KnownCrack) model.HicSvi = "High";
        else await RecalcSvi();
    }

    private async Task Calculate()
    {
        isCalculating = true; StateHasChanged();
        try { model = await HicService.CalculateHicAsync(model); }
        catch (Exception ex) { await ShowError("Calculate Error", ex.Message); }
        finally { isCalculating = false; StateHasChanged(); }
    }

    private async Task Save()
    {
        isSaving = true; StateHasChanged();
        try
        {
            model = await HicService.SaveHicAsync(model);
            hasExistingData = true;
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Saved!", text = "HIC/SOHIC-H2S record saved successfully.", icon = "success", timer = 2000, showConfirmButton = false });
        }
        catch (Exception ex) { await ShowError("Save Error", ex.Message); }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task DeleteRecord()
    {
        bool confirmed = await JS.InvokeAsync<bool>("sweetAlert.confirmDelete",
            "Are you sure?", "Do you want to delete this HIC/SOHIC-H2S record?");
        if (!confirmed) return;
        try
        {
            await HicService.DeleteHicAsync(model.ProcID, model.EquID, model.CompID);
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Deleted!", text = "Record has been deleted.", icon = "success", timer = 1800, showConfirmButton = false });
            ClearForm();
        }
        catch (Exception ex) { await ShowError("Delete Error", ex.Message); }
    }

    private void ClearForm()
    {
        model = new();
        selectedProcessArea = selectedEquipment = selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
    }

    private Task ShowError(string title, string text) =>
        JS.InvokeVoidAsync("Swal.fire", new { title, text, icon = "error" }).AsTask();
}
