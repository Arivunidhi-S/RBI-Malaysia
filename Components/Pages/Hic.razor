@page "/pof-scc-hic"

@using RBI_Malaysia.Models
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject SulfidationService SulfidationService
@inject UserSession UserSession
@inject IJSRuntime JS
@inject NavigationManager Nav


<PageTitle>POF — HIC / SOHIC-H2S</PageTitle>

<div class="staff-page">

    <!-- SCC Top Navigation Menu -->
    @layout StaffLayout

    <div class="staff-card">
        <div class="staff-card-header">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-radioactive me-2 text-warning"></i> HIC / SOHIC-H2S
                </h5>
                <small>SCCDF HIC / SOHIC-H2S Factor Calculation</small>
            </div>
        </div>

        <div class="staff-card-body">

            <!-- Cascading Filters -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Process Area <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedProcessArea" @onchange="ProcessAreaChanged">
                        <option value="0">-- Select Process Area --</option>
                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">@item.ProcessArea</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Equipment <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedEquipment" @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">
                        <option value="0">-- Select Equipment --</option>
                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">@item.EquPID</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Component <span class="text-danger">*</span></label>
                    <select class="form-select" value="@selectedComponent" @onchange="ComponentChanged"
                            disabled="@(selectedEquipment <= 0)">
                        <option value="0">-- Select Component --</option>
                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">@item.CompNo</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Input Form -->
            <EditForm Model="@model" OnValidSubmit="Calculate" FormName="SulfidationForm">
                <DataAnnotationsValidator />

                <h6 class="text-muted border-bottom pb-1 mb-3">Basic Inputs</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Age <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="model.SulAge" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Effectiveness <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.SulInsEff">
                            <option value="">Select</option>
                            <option value="A">A — Highly Effective</option>
                            <option value="B">B — Usually Effective</option>
                            <option value="C">C — Fairly Effective</option>
                            <option value="D">D — Poorly Effective</option>
                            <option value="E">E — In Effective</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. of Inspections <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.SulnofIns">
                            <option value="">Select</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Inspection Date</label>
                        <InputDate class="form-control" @bind-Value="model.InspectDate" />
                    </div>
                </div>

                <!-- Step 1: pH + H2S → Environmental Severity -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Environmental Severity (STEP 1)</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">pH of Water</label>
                        <select class="form-select" @bind="model.PHwaterCode" @bind:after="RecalcEnvSeverity">
                            <option value="">Select</option>
                            @foreach (var opt in SulfidationService.PHOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">SteelSulfar</label>
                        <select class="form-select" @bind="model.H2SCode" @bind:after="RecalcEnvSeverity">
                            <option value="">Select</option>
                            @foreach (var opt in SulfidationService.H2SOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-bold">Environmental Severity (auto)</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-danger" value="@model.Severity" readonly />
                    </div>
                </div>

                <!-- Step 2: Heat + Brinnell + Env Severity → Svi -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Susceptibility & Svi (STEP 2)</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Heat Treatment</label>
                        <select class="form-select" @bind="model.HeatCode" @bind:after="RecalcSvi">
                            <option value="">Select</option>
                            @foreach (var opt in SulfidationService.HeatOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Steel Sulfar</label>
                        <select class="form-select" @bind="model.BrinnellCode" @bind:after="RecalcSvi">
                            <option value="">Select</option>
                            @foreach (var opt in SulfidationService.BrinnellOptions)
                            {
                                <option value="@opt.Code">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary fw-bold">Susceptibility / Svi (auto)</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-primary" value="@model.SulSvi" readonly />
                    </div>
                    <!-- Step 3: Known Crack override -->
                    <div class="col-md-3 d-flex align-items-end pb-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="knownCrack"
                                   checked="@model.KnownCrack" @onchange="OnKnownCrackChanged" />
                            <label class="form-check-label fw-bold text-danger" for="knownCrack">
                                Known Cracking Present<br />
                                <small class="text-muted fw-normal">(overrides Svi to "High")</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Result -->
                <h6 class="text-muted border-bottom pb-1 mb-3 mt-4">Result</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-secondary fw-bold"> Df - SOHIC</label>
                        <input type="text" class="form-control fw-bold bg-warning-subtle text-danger"
                               value="@model.SulDf" readonly />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="staff-buttons mt-4 d-flex gap-2">
                    <button type="button" class="btn btn-info text-white fw-bold"
                            @onclick="Calculate" disabled="@isCalculating">
                        @(isCalculating ? "Calculating..." : "Calculate")
                    </button>
                    <button type="button" class="btn btn-success fw-bold"
                            @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Clear</button>
                    @if (hasExistingData)
                    {
                        <button type="button" class="btn btn-danger" @onclick="DeleteRecord">Delete</button>
                    }
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code
{
    private SulfidationModel model = new();
    private decimal selectedProcessArea, selectedEquipment, selectedComponent;

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel>   equipments   = new();
    private List<ComponentModel>   components   = new();

    private bool hasExistingData, isSaving, isCalculating;

    protected override async Task OnInitializedAsync() =>
        processAreas = await SulfidationService.GetProcessAreasAsync(UserSession.CompanyID);

    private async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedEquipment = 0; selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
        if (selectedProcessArea > 0)
            equipments = await SulfidationService.GetEquipmentsByProcessAsync(selectedProcessArea);
    }

    private async Task EquipmentChanged(ChangeEventArgs e)
    {
        selectedEquipment = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        selectedComponent = 0;
        components.Clear();
        hasExistingData = false;
        if (selectedEquipment > 0)
            components = await SulfidationService.GetComponentsByEquipmentAsync(selectedEquipment.ToString());
    }

    private async Task ComponentChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal id)) return;
        selectedComponent = id;
        try
        {
            var existing = await SulfidationService.GetSulfidationRecordAsync(selectedProcessArea, selectedEquipment, id);
            if (existing != null) { model = existing; hasExistingData = true; }
            else { model = new() { ProcID = selectedProcessArea, EquID = selectedEquipment, CompID = id }; hasExistingData = false; }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Load Error", text = ex.Message, icon = "error" });
        }
    }

    // STEP 1 — pH + H2S changed → recalculate Environmental Severity
    private async Task RecalcEnvSeverity()
    {
        if (string.IsNullOrEmpty(model.PHwaterCode) || string.IsNullOrEmpty(model.H2SCode)) return;
        try
        {
            model.Severity = await SulfidationService.ComputeEnvSeverityAsync(model.H2SCode, model.PHwaterCode);
            model.PHwater = SulfidationService.PHOptions.Find(o => o.Code == model.PHwaterCode).Label;
            model.H2S = SulfidationService.H2SOptions.Find(o => o.Code == model.H2SCode).Label;
            // Cascade: if Heat and Brinnell are already set, auto-recalc Svi too
            await RecalcSvi();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Error", text = ex.Message, icon = "error" });
        }
    }

    // STEP 2 — Heat + Brinnell + Severity changed → recalculate Svi
    private async Task RecalcSvi()
    {
        if (string.IsNullOrEmpty(model.BrinnellCode) || string.IsNullOrEmpty(model.HeatCode) || string.IsNullOrEmpty(model.Severity)) return;
        if (model.KnownCrack) return; // override in effect
        try
        {
            model.SulSvi = await SulfidationService.ComputeSviAsync(model.BrinnellCode, model.HeatCode, model.Severity);
            model.Heat = SulfidationService.HeatOptions.Find(o => o.Code == model.HeatCode).Label;
            model.Brinnell = SulfidationService.BrinnellOptions.Find(o => o.Code == model.BrinnellCode).Label;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Error", text = ex.Message, icon = "error" });
        }
    }

    // STEP 3 — Known crack checkbox → override or restore Svi
    private async Task OnKnownCrackChanged(ChangeEventArgs e)
    {
        model.KnownCrack = (bool)(e.Value ?? false);
        if (model.KnownCrack)
        {
            model.SulSvi = "High";
        }
        else
        {
            // restore from chain
            await RecalcSvi();
        }
    }

    private async Task Calculate()
    {
        isCalculating = true; StateHasChanged();
        try { model = await SulfidationService.CalculateSulfidationAsync(model); }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Calculate Error", text = ex.Message, icon = "error" });
        }
        finally { isCalculating = false; StateHasChanged(); }
    }

    private async Task Save()
    {
        isSaving = true; StateHasChanged();
        try
        {
            model = await SulfidationService.SaveSulfidationAsync(model);
            hasExistingData = true;
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Saved!", text = "Sulfidation record saved successfully.", icon = "success", timer = 2000, showConfirmButton = false });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Save Error", text = ex.Message, icon = "error" });
        }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task DeleteRecord()
    {
        // bool confirm = await JS.InvokeAsync<bool>("Swal.fire", new
        // {
        //     title = "Delete Record?",
        //     text = "This Sulfidation record will be permanently deleted.",
        //     icon = "warning",
        //     showCancelButton = true,
        //     confirmButtonColor = "#d33",
        //     cancelButtonColor = "#6c757d",
        //     confirmButtonText = "Yes, delete it!",
        //     cancelButtonText = "Cancel"
        // }).ContinueWith(t => t.Result.GetProperty("isConfirmed").GetBoolean());

        bool confirmed =
            await JS.InvokeAsync<bool>("sweetAlert.confirmDelete", "Are you sure?", $"Do you want to delete this Sulfidation record?");

        if (!confirmed) return;
        try
        {
            await SulfidationService.DeleteSulfidationAsync(model.ProcID, model.EquID, model.CompID);
            await JS.InvokeVoidAsync("Swal.fire",
                new { title = "Deleted!", text = "Record has been deleted.", icon = "success", timer = 1800, showConfirmButton = false });
            ClearForm();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new { title = "Delete Error", text = ex.Message, icon = "error" });
        }
    }

    private void ClearForm()
    {
        model = new();
        selectedProcessArea = selectedEquipment = selectedComponent = 0;
        equipments.Clear(); components.Clear();
        hasExistingData = false;
    }
}
