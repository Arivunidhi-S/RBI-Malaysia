@code {

    private bool adminMasterOpen;
    private bool masterOpen;
    private bool inspectionOpen;
    private bool pofOpen;
    private bool cofOpen;
    private bool reportsOpen;


    private void ToggleAdminMaster()
    {
        adminMasterOpen = !adminMasterOpen;
    }

    private void ToggleMaster()
    {
        masterOpen = !masterOpen;
    }

    private void ToggleInspection()
    {
        inspectionOpen = !inspectionOpen;
    }

    private void TogglePof()
    {
        pofOpen = !pofOpen;
    }

    private void ToggleCof()
    {
        cofOpen = !cofOpen;
    }

    private void ToggleReports()
    {
        reportsOpen = !reportsOpen;
    }
}