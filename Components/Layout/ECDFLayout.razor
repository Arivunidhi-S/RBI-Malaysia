
@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager Nav

<div class="staff-layout-container">
    <!-- உங்களுடைய தனி மெனு பகுதி -->
    <nav class="staff-Menu">
        <ul>
            <li><a class="nav-link @(Nav.Uri.Contains("externaldamage") ? "active" : "")" href="/externaldamage">External Corrosion Damage</a></li>
            <li><a class="nav-link @(Nav.Uri.Contains("pof-cui") ? "active" : "")" href="/pof-cui">Corrosion Under Insulation</a></li>
            <li><a class="nav-link @(Nav.Uri.Contains("externalclscc") ? "active" : "")" href="/externalclscc">External CLSCC</a></li>
            <li><a class="nav-link @(Nav.Uri.Contains("externalcuiclscc") ? "active" : "")" href="/externalcuiclscc">External CUI CLSCC</a></li>
        </ul>
    </nav>

    <!-- பக்கங்களின் உள்ளடக்கங்கள் (Page Content) தோன்றும் இடம் -->
    <div class="staff-page-content">
        @Body
    </div>
</div>
