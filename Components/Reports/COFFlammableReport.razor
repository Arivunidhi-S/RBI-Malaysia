@page "/cof-flame-report/{Id:int}"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>COF Flammable Report</PageTitle>

<div class="staff-page">
    <div class="card staff-card">
        <div class="card-header staff-card-header">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-pdf me-2 text-danger"></i> COF Flammable Report
            </h5>
        </div>
        <div class="card-body staff-card-body">
            <iframe id="ReportFrame" style="width:100%; height:750px; border:1px solid #ddd;" title="COF Flammable Report">
            </iframe>
        </div>
    </div>
</div>

@code {
    private string reportUrl = "";
    [Parameter]
    public int Id { get; set; }
    // ⭐ பக்கம் லோடு ஆகும்போது appsettings-ல் இருந்து URL எடுக்கப்படுகிறது
    protected override void OnInitialized()
    {
        string rUrl = Configuration["ApiSettings:ReportUrl"] ?? "";
        reportUrl = $"{rUrl}COFFlammableDetails?id={Id}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(reportUrl))
        {
            await JS.InvokeVoidAsync("showReport", reportUrl);
        }
    }
}
