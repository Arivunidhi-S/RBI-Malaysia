@page "/Reports/equip-detail-report"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject LiningDamageService ComponentService
@inject UserSession UserSession

<PageTitle> Equipment Details Report</PageTitle>


<div class="staff-page">

    <div class="card staff-card">

        <div class="card-header staff-card-header">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-pdf me-2"></i>
                Equipment Details Report
            </h5>
        </div>

        <div class="card-body staff-card-body">

            <div class="row mb-3">

                <!-- PROCESS AREA -->
                <div class="col-md-3">

                   @*  <label class="form-label">
                        Process Area
                        <span class="text-danger">*</span>
                    </label> *@

                    <select class="form-select"
                            value="@selectedProcessArea"
                            @onchange="ProcessAreaChanged">

                        <option value="0">
                            -- Select Process Area --
                        </option>

                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">
                                @item.ProcessArea
                            </option>
                        }

                    </select>

                </div>


                <!-- EQUIPMENT -->
                <div class="col-md-3">

                  @*   <label class="form-label">
                        Equipment
                        <span class="text-danger">*</span>
                    </label> *@

                    <select class="form-select"
                            value="@selectedEquipment"
                            @onchange="EquipmentChanged"
                            disabled="@(selectedProcessArea <= 0)">

                        <option value="">
                            -- Select Equipment --
                        </option>

                        @foreach (var item in equipments)
                        {
                            <option value="@item.EquAutoID">
                                @item.EquPID
                            </option>
                        }

                    </select>

                </div>


                <!-- COMPONENT -->
                <div class="col-md-3">

                   @*  <label class="form-label">
                        Component
                        <span class="text-danger">*</span>
                    </label> *@

                    <select class="form-select"
                            @bind="@selectedComponent"
                            @bind:after="ComponentChanged"
                            disabled="@string.IsNullOrWhiteSpace(selectedEquipment)">

                        <option value="">
                            -- Select Component --
                        </option>

                        @foreach (var item in components)
                        {
                            <option value="@item.CompAutoID">
                                @item.CompNo
                            </option>
                        }

                    </select>

                </div>

                @*    <div class="col-md-5">

                    <label class="form-label">
                        Process Area
                        <span class="text-danger">*</span>
                    </label>

                    <select class="form-select"
                            @bind="@selectedProcessArea"
                            @bind:after="ProcessAreaChanged">

                        <option value="0">
                            -- Select Process Area --
                        </option>

                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">
                                @item.ProcessArea
                            </option>
                        }

                    </select>
                </div> *@

            </div>

            @if (selectedProcessArea > 0)
            {
                <iframe id="ReportFrame"
                        style="width:100%;
                                           height:750px;
                                           border:1px solid #ddd;"
                        title="Student Report">
                </iframe>
            }

        </div>

    </div>

</div>

@code {

    private List<ProcessAreaModel> processAreas = new();
    private List<EquipmentModel> equipments = new();
    private List<ComponentModel> components = new();

    private decimal selectedProcessArea = 0;
    private string? selectedEquipment;
    private string? selectedComponent;
    private decimal selectedComponentId = 0;


    protected override async Task OnInitializedAsync()
    {
        decimal companyId = Convert.ToDecimal(UserSession.CompanyID);
        processAreas = await ComponentService.GetProcessAreasAsync(companyId);
    }

    public async Task ProcessAreaChanged(ChangeEventArgs e)
    {
        selectedProcessArea = 0;

        decimal.TryParse(
            e.Value?.ToString(),
            out selectedProcessArea);

        selectedEquipment = null;
        selectedComponent = null;
        selectedComponentId = 0;

        equipments.Clear();
        components.Clear();

       // ClearCalculation();

        if (selectedProcessArea <= 0)
            return;

        try
        {
        equipments = await ComponentService.GetEquipmentsAsync(selectedProcessArea);
        }
        catch (Exception ex)
        {
            // await ShowError(
            //     "Equipment loading failed.",
            //     ex.Message);
        }
    }

    private async Task EquipmentChanged(
       ChangeEventArgs e)
    {
        selectedEquipment =
            e.Value?.ToString();

        selectedComponent = null;
        selectedComponentId = 0;

        components.Clear();

        // ClearCalculation();

        if (string.IsNullOrWhiteSpace(
            selectedEquipment))
        {
            return;
        }

        try
        {
            components = await ComponentService.GetComponentsAsync(selectedEquipment);
        }
        catch (Exception ex)
        {
            // await ShowError(
            //     "Component loading failed.",
            //     ex.Message);
        }
    }
   

    public async Task ComponentChanged()
    {
        if (selectedProcessArea <= 0)
            return;
        string rUrl = Configuration["ApiSettings:ReportUrl"] ?? "";
        string reportUrl = $"{rUrl}EquipmentDetails?id={selectedComponent}";

        await JS.InvokeVoidAsync(
            "showReport",
            reportUrl);
    }




}
