@page "/Reports/equipment-report"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using RBI_Malaysia.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject ProcessAreaService ProcessAreaService
@inject UserSession UserSession

<PageTitle>Equipment List Report</PageTitle>


<div class="staff-page">

    <div class="card staff-card">

        <div class="card-header staff-card-header">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-pdf me-2"></i>
                Equipment List Report
            </h5>
        </div>

        <div class="card-body staff-card-body">

            <div class="row mb-3">
                <div class="col-md-5">
                    <select class="form-select"
                            @bind="@selectedProcessArea">
                      @*   @bind:after="ProcessAreaChanged" *@

                        <option value="0">
                            -- Select Process Area --
                        </option>

                        @foreach (var item in processAreas)
                        {
                            <option value="@item.ProcessAreaID">
                                @item.ProcessArea
                            </option>
                        }

                    </select>
                </div>
                <div class="col-md-5 d-flex justify-content-between align-items-center">
                    <div class="staff-buttons">
                        <button type="button" class="btn btn-danger fw-bold" @onclick="ProcessAreaChanged">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                            PDF View
                        </button>
                        <button type="button" class="btn btn-success fw-bold" @onclick="Exceldownload">
                            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                            Excel Download
                        </button>
                    </div>
                </div>
            </div>

            @if (selectedProcessArea > 0)
            {
                <iframe id="ReportFrame" style="width:100%;height:750px; border:1px solid #ddd;" title="Equipment List Report"></iframe>
            }

        </div>

    </div>

</div>

@code {

    private List<ProcessAreaModel> processAreas = new();

    private decimal selectedProcessArea = 0;

    protected override async Task OnInitializedAsync()
    {
        decimal companyId = Convert.ToDecimal(UserSession.CompanyID);
        processAreas = await ProcessAreaService.GetProcessAreasAsync(companyId);

    }

    public async Task ProcessAreaChanged()
    {
        if (selectedProcessArea <= 0)
            return;
        string rUrl = Configuration["ApiSettings:ReportUrl"] ?? "";
        string reportUrl = $"{rUrl}EquipmentList?id={selectedProcessArea}";

        await JS.InvokeVoidAsync("showReport", reportUrl);
    }

    public async Task Exceldownload()
    {
        if (selectedProcessArea <= 0)
            return;
        string rUrl = Configuration["ApiSettings:ReportUrl"] ?? "";
        string reportUrl = $"{rUrl}EquipmentList?id={selectedProcessArea}&format=excel";

        await JS.InvokeVoidAsync("showReport", reportUrl);
    }



}
